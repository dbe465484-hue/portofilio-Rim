# Local (Vite) — Ollama must be running: ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Production (Vercel) — recommended for visitors (fast open models)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional local quality upgrade (slower): OLLAMA_MODEL=mistral
# Optional fallback
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
